{
  "schema": "pmcro.capabilities/v1",
  "agent": "filesystem-agent",
  "executionRule": "registered AND runtime-present AND authorized",
  "manualParity": {
    "required": true,
    "rule": "agent and manual terminal use the same scripts with the same arguments, exit codes, and evidence"
  },
  "capabilities": [
    {
      "plugin": "filesystem",
      "skill": "list",
      "route": "@filesystem-agent /filesystem:list"
    },
    {
      "plugin": "filesystem",
      "skill": "read",
      "route": "@filesystem-agent /filesystem:read"
    }
  ]
}
